SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/gym_tracker
SPRING_DATASOURCE_USERNAME=gym_user
SPRING_DATASOURCE_PASSWORD=replace-me
SESSION_COOKIE_SECURE=false
SESSION_TIMEOUT=7d

# Set both values for one startup only when upgrading an existing account.
TRACKER_BOOTSTRAP_EMAIL=
TRACKER_BOOTSTRAP_PASSWORD=

# Optional recovery. Do not enable until SMTP and the public origin are ready.
PASSWORD_RESET_ENABLED=false
APP_PUBLIC_URL=https://your-app.onrender.com
MAIL_FROM=tracker@your-verified-domain.example
# Set SPRING_MAIL_HOST only when configuring a real mail server.
# SPRING_MAIL_HOST=smtp.your-provider.example
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
