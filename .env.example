SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/gym_tracker
SPRING_DATASOURCE_USERNAME=gym_user
SPRING_DATASOURCE_PASSWORD=replace-me
SESSION_COOKIE_SECURE=false
SESSION_TIMEOUT=7d

